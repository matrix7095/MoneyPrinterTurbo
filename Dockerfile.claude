# Claude Code 上游兼容变体：基于官方发布镜像安装当前 checkout 的依赖与 claude CLI。
#
# Claude 订阅（Pro / Max / Team）不签发 API Key，只有 Claude Code 官方客户端
# 能使用订阅凭证，所以 `claude_code` Provider 依赖容器内存在可执行的 claude
# CLI。上游基础镜像仍是可变标签；本地 Compose 会覆盖应用目录，因此这里安装
# 当前 checkout 的 editable workspace，保持运行时源码与依赖路径一致。
FROM ghcr.io/harry0703/moneyprinterturbo:latest

WORKDIR /MoneyPrinterTurbo
COPY requirements.txt ./
COPY packages ./packages
RUN python3 -m pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt

# CLI 版本固定，避免镜像重建时行为漂移；升级时改这里的版本号即可。
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# claude CLI 通过 npm 分发，发布镜像里没有 Node.js，需要先装 NodeSource 源。
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
